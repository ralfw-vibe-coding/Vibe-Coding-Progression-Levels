# Vorlage. Die eigene .env liegt nicht im Repository (siehe .gitignore).
#
# Werte mit Leerzeichen oder spitzen Klammern gehören in Anführungszeichen — run.sh liest diese
# Datei über die Shell ein, und ein unquotiertes "<" bricht sie ab dieser Zeile ab.

# --- Kursquellen (optional; ohne sie bleibt Yahoo als einzige Quelle)
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=

# --- Deployment (nur für deno task deploy nötig)
DENO_DEPLOY_TOKEN=

# --- Datenbank. Ohne diese Zeile fällt der Server auf SQLite zurück und läuft ohne Einrichtung.
DATABASE_URL=

# --- Zugang
# Maschinenzugang für curl und Skripte. Wer ihn hat, gilt als Verwalter.
BACKEND_API_KEY=
# Wer die Zugangsliste pflegen darf. Steht nicht in der Liste, sondern hier — und kommt
# dadurch immer herein.
ADMIN_EMAIL=

# --- Anmeldung per Einmalcode
# Ohne AUTH_SESSION_SECRET gibt es keine Anmeldung, nur den API-Schlüssel.
# Erzeugen mit: openssl rand -base64 32
AUTH_SESSION_SECRET=
# Wie lange eine Sitzung gilt (604800 = 7 Tage).
JWT_TTL_SECONDS=604800
# Mailversand. Fehlt der Schlüssel, landen die Codes lokal auf der Konsole; deployt gibt es
# dann keine Anmeldung per Code.
RESEND_API_KEY=
AUTH_FROM_EMAIL="Mein Depot <no-reply@deine-domain.de>"
# Ein Code, der immer gilt — der Weg hinein, wenn der Mailversand hakt. Kein Bequemlichkeits-
# code, sondern ein zweiter Generalschlüssel: lang, zufällig, nie in einer Nachricht weitergeben.
AUTH_SECRET_OTP=
